# OpenAI configuration
OPENAI_API_KEY=
MODEL_TEXT=gpt-4.1-mini
MODEL_EMBED=text-embedding-3-small

# Local storage
CHROMA_DIR=storage/chroma
REPORT_DIR=storage/reports
SQLITE_DB_FILE=storage/workspace.db

# Retrieval tuning
CLAUSE_TOP_K=3

# Optional (keeps scoring deterministic; only adds explanation text)
ENABLE_LLM_RISK_EXPLANATIONS=0

# Auth (change for production)
AUTH_SECRET=change-me-for-production
AUTH_USERS_FILE=storage/auth/users.json

# Local LLM (free). Set to "ollama" after installing and running Ollama.
LLM_PROVIDER=stub
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_MS=20000
